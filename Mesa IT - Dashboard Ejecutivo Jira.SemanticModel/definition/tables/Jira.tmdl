	column MesTxt =
			
			UPPER(LEFT(FORMAT(Jira[Creado], "MMMM"),1))
			&
			LOWER(
			    MID(
			        FORMAT(Jira[Creado], "MMMM"),
			        2,
			        100
			    )
			)
		lineageTag: e0b9c3c4-c9cf-453c-b984-ef7a4bf62858
		summarizeBy: none
		sortByColumn: MesNro

		changedProperty = SortByColumn

