	column 'Días Resolución' =
			
			IF(
			    ISBLANK(Jira[Fecha_Resolucion]),
			    BLANK(),
			    DATEDIFF(
			        Jira[Creado],
			        Jira[Fecha_Resolucion],DAY
			    )
			)
		formatString: 0
		lineageTag: ce77906b-4393-4c72-84eb-247bc50b53cb
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Horas Resolución' =
			
			IF(
			    ISBLANK(Jira[Fecha_Resolucion]),
			    BLANK(),
			    DATEDIFF(
			        Jira[Creado],
			        Jira[Fecha_Resolucion],HOUR
			    )
			)
		dataType: string
		lineageTag: 724890e6-4eb5-4764-9438-e9d3c82cf45d
