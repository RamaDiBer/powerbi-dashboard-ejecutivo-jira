	/// Falla = Problema o Incidente; el resto son pedidos de servicio
	column Categoría = IF(Jira[Tipo] IN {"Problema", "Incidente"}, "Falla", "Pedido / Servicio")
		lineageTag: ddce66c3-39ad-495e-9f36-93a74dc56be9

	/// Título en minúsculas y sin punto final, para agrupar tickets repetidos
	column 'Resumen Normalizado' =
			
			VAR t = LOWER(TRIM(Jira[Nombre del Ticket]))
			RETURN IF(RIGHT(t, 1) = ".", LEFT(t, LEN(t) - 1), t)
		lineageTag: c81846de-18a4-4c66-879d-e04978302414

	column MesResolucionOrden = IF(NOT ISBLANK(Jira[Fecha_Resolucion]), YEAR(Jira[Fecha_Resolucion]) * 100 + MONTH(Jira[Fecha_Resolucion]))
		isHidden
		lineageTag: 9536bd70-f277-471f-851e-7966fde7ef6a
		summarizeBy: none

	partition Jira = m
		mode: import
		source =
				let
				    BaseUrl = "https://mirgor.atlassian.net",
				
				    ValoresPlanta = {"Rodney", "Escobar", "Fortinox", "Rosario - Enllantado"},
				
				    // Rosario - Enllantado no existe como opción en Unidad de Negocio (customfield_10168): no agregarlo ahí o la consulta falla
				    JQL =
				        "project = MDSURET AND created >= ""2025-11-01"" AND (" &
				        "customfield_10434 IN (""Rodney"", ""Escobar"", ""Fortinox"", ""Rosario - Enllantado"") OR " &
				        "customfield_10128 IN (""Rodney"", ""Escobar"", ""Fortinox"", ""Rosario - Enllantado"") OR " &
				        "customfield_10168 IN (""Rodney"", ""Escobar"", ""Fortinox"")" &
				        ")",
				
				    // components = Componente, reporter = Informante, timespent = horas registradas, customfield_10187 = Dirección Requirente
				    Fields =
				        "summary,status,assignee,priority,created,updated,resolutiondate,issuetype," &
				        "customfield_10434,customfield_10128,customfield_10168," &
				        "customfield_10232,customfield_10233,customfield_11073,customfield_10443,customfield_10167," &
				        "components,reporter,timespent,customfield_10187",
				
				    GetPage = (Token as nullable text) =>
				        let
				            QueryParams =
				                if Token = null then
				                    [
				                        jql = JQL,
				                        fields = Fields
				                    ]
				                else
				                    [
				                        jql = JQL,
				                        fields = Fields,
				                        nextPageToken = Token
				                    ],
				
				            Response = Json.Document(
				                Web.Contents(
				                    BaseUrl,
				                    [
				                        RelativePath = "rest/api/3/search/jql",
				                        Query = QueryParams
				                    ]
				                )
				            )
				        in
				            Response,
				
				    Pages =
				        List.Generate(
				            () => GetPage(null),
				            each _ <> null,
				            each
				                if Record.Field(_, "isLast") = true then
				                    null
				                else
				                    GetPage(Record.Field(_, "nextPageToken")),
				            each _
				        ),
				
				    TodasLasIssues =
				        List.Combine(
				            List.Transform(Pages, each [issues])
				        ),
				
				    Tabla =
				        Table.FromList(
				            TodasLasIssues,
				            Splitter.SplitByNothing(),
				            null,
				            null,
				            ExtraValues.Error
				        ),
				
				    Expandido =
				        Table.ExpandRecordColumn(
				            Tabla,
				            "Column1",
				            {"key", "fields"},
				            {"key", "fields"}
				        ),
				
				    Fields_Exp =
				        Table.ExpandRecordColumn(
				            Expandido,
				            "fields",
				            {
				                "summary",
				                "status",
				                "assignee",
				                "priority",
				                "created",
				                "updated",
				                "resolutiondate",
				                "issuetype",
				                "customfield_10434",
				                "customfield_10128",
				                "customfield_10168",
				                "customfield_10232",
				                "customfield_10233",
				                "customfield_11073",
				                "customfield_10443",
				                "customfield_10167",
				                "components",
				                "reporter",
				                "timespent",
				                "customfield_10187"
				            },
				            {
				                "summary",
				                "status",
				                "assignee",
				                "priority",
				                "created",
				                "updated",
				                "resolutiondate",
				                "issuetype",
				                "customfield_10434",
				                "customfield_10128",
				                "customfield_10168",
				                "customfield_10232",
				                "customfield_10233",
				                "customfield_11073",
				                "customfield_10443",
				                "customfield_10167",
				                "components",
				                "reporter",
				                "timespent",
				                "customfield_10187"
				            }
				        ),
				
				    // Expansiones básicas
				    Status = Table.ExpandRecordColumn(Fields_Exp, "status", {"name"}, {"Estado"}),
				    Assignee = Table.ExpandRecordColumn(Status, "assignee", {"displayName"}, {"Asignado"}),
				    Priority = Table.ExpandRecordColumn(Assignee, "priority", {"name"}, {"Prioridad"}),
				    IssueType = Table.ExpandRecordColumn(Priority, "issuetype", {"name"}, {"Tipo"}),
				    Reporter = Table.ExpandRecordColumn(IssueType, "reporter", {"displayName"}, {"Informante"}),
				
				    // Planta / Site / Unidad de Negocio
				    CF10434 = Table.ExpandRecordColumn(Reporter, "customfield_10434", {"value"}, {"_CampoPlanta"}),
				    CF10128 = Table.ExpandRecordColumn(CF10434, "customfield_10128", {"value"}, {"_CampoSiteOrigen"}),
				    CF10168 = Table.ExpandRecordColumn(CF10128, "customfield_10168", {"value"}, {"_CampoUnidadNegocio"}),
				
				    ConPlanta =
				        Table.AddColumn(
				            CF10168,
				            "Planta",
				            each
				                if List.Contains(ValoresPlanta, [_CampoPlanta]) then
				                    [_CampoPlanta]
				                else if List.Contains(ValoresPlanta, [_CampoSiteOrigen]) then
				                    [_CampoSiteOrigen]
				                else if List.Contains(ValoresPlanta, [_CampoUnidadNegocio]) then
				                    [_CampoUnidadNegocio]
				                else
				                    null,
				            type text
				        ),
				
				    Filtrados = Table.SelectRows(ConPlanta, each [Planta] <> null),
				
				    LimpioCamposAux =
				        Table.RemoveColumns(
				            Filtrados,
				            {"_CampoPlanta", "_CampoSiteOrigen", "_CampoUnidadNegocio"}
				        ),
				
				    // Funciones auxiliares para parsear campos complejos sin error
				    fnGetOptionValue = (val as any) =>
				        if val is record then
				            if Record.HasFields(val, "value") and Record.Field(val, "value") <> null then Record.Field(val, "value")
				            else if Record.HasFields(val, "name") and Record.Field(val, "name") <> null then Record.Field(val, "name")
				            else null
				        else if val is text then val
				        else null,
				
				    fnGetNombreGrupo = (val as any) =>
				        if val is record then
				            if Record.HasFields(val, "name") and Record.Field(val, "name") <> null then Record.Field(val, "name")
				            else if Record.HasFields(val, "value") and Record.Field(val, "value") <> null then Record.Field(val, "value")
				            else null
				        else if val is text then val
				        else null,
				
				    // Extracción de Grupo Resolutor
				    AddGrupoResolutor = Table.AddColumn(LimpioCamposAux, "Grupo_Resolutor", each fnGetNombreGrupo([customfield_11073]), type text),
				
				    // Extracción de Aplicación (unificando Aplicaciones mesa IT y Aplicaciones)
				    AddApp1 = Table.AddColumn(AddGrupoResolutor, "_app1", each fnGetOptionValue([customfield_10443]), type text),
				    AddApp2 = Table.AddColumn(AddApp1, "_app2", each fnGetOptionValue([customfield_10167]), type text),
				    ConsolidarApp = Table.AddColumn(
				        AddApp2,
				        "Aplicacion",
				        each if [_app1] <> null and [_app1] <> "" then [_app1] else [_app2],
				        type text
				    ),
				
				    LimpioApps = Table.RemoveColumns(ConsolidarApp, {"_app1", "_app2", "customfield_11073", "customfield_10443", "customfield_10167"}),
				
				    // Componente (puede haber varios), Dirección Requirente y horas registradas en worklog
				    AddComponente = Table.AddColumn(
				        LimpioApps,
				        "Componente",
				        each
				            if [components] is list and List.Count([components]) > 0 then
				                Text.Combine(List.Transform([components], each fnGetOptionValue(_)), ", ")
				            else
				                null,
				        type text
				    ),
				    AddArea = Table.AddColumn(AddComponente, "Area_Requirente", each fnGetOptionValue([customfield_10187]), type text),
				    AddHoras = Table.AddColumn(AddArea, "Horas_Trabajadas", each if [timespent] is number then Number.Round([timespent] / 3600, 2) else null, type number),
				    LimpioExtras = Table.RemoveColumns(AddHoras, {"components", "customfield_10187", "timespent"}),
				
				    // Conversión de tipos de Fechas
				    TiposFechas =
				        Table.TransformColumnTypes(
				            LimpioExtras,
				            {
				                {"created", type datetimezone},
				                {"updated", type datetimezone},
				                {"resolutiondate", type datetimezone}
				            }
				        ),
				
				    // --- EXTRACCIÓN DE MÉTRICAS DE SLA ---
				    fnParseSLA = (slaRecord as nullable record) as record =>
				        let
				            completedCycles = if slaRecord <> null and Record.HasFields(slaRecord, "completedCycles") then Record.Field(slaRecord, "completedCycles") else {},
				            ongoingCycle = if slaRecord <> null and Record.HasFields(slaRecord, "ongoingCycle") then Record.Field(slaRecord, "ongoingCycle") else null,
				            cycle = if List.Count(completedCycles) > 0 then List.First(completedCycles) else ongoingCycle,
				
				            elapsedMillis = if cycle <> null and Record.HasFields(cycle, "elapsedTime") and Record.Field(cycle, "elapsedTime") <> null then Record.Field(Record.Field(cycle, "elapsedTime"), "millis") else null,
				            isBreached = if cycle <> null and Record.HasFields(cycle, "breached") then Record.Field(cycle, "breached") else null,
				
				            elapsedHours = if elapsedMillis <> null then Number.Round(elapsedMillis / 3600000, 2) else null
				        in
				            [Horas = elapsedHours, Vencido = isBreached],
				
				    // SLA Atención
				    AddSLAAtencion = Table.AddColumn(TiposFechas, "_sla_atencion", each fnParseSLA([customfield_10232])),
				    ExpandSLAAtencion = Table.ExpandRecordColumn(AddSLAAtencion, "_sla_atencion", {"Horas", "Vencido"}, {"Atencion_Horas", "Atencion_SLA_Vencido"}),
				
				    // SLA Resolución
				    AddSLAResolucion = Table.AddColumn(ExpandSLAAtencion, "_sla_resolucion", each fnParseSLA([customfield_10233])),
				    ExpandSLAResolucion = Table.ExpandRecordColumn(AddSLAResolucion, "_sla_resolucion", {"Horas", "Vencido"}, {"Resolucion_Horas", "Resolucion_SLA_Vencido"}),
				
				    // Tiempo total de cierre en días
				    AddDiasTotales = Table.AddColumn(
				        ExpandSLAResolucion,
				        "Dias_Totales_Cierre",
				        each
				            if [resolutiondate] <> null then
				                Number.Round(Duration.TotalDays([resolutiondate] - [created]), 2)
				            else if [Estado] = "Resuelta" or [Estado] = "Cerrado" or [Estado] = "Closed" then
				                Number.Round(Duration.TotalDays([updated] - [created]), 2)
				            else
				                null,
				        type number
				    ),
				
				    LimpioSLA = Table.RemoveColumns(AddDiasTotales, {"customfield_10232", "customfield_10233"}),
				
				    Renombrado =
				        Table.RenameColumns(
				            LimpioSLA,
				            {
				                {"key", "Ticket"},
				                {"summary", "Nombre del Ticket"},
				                {"created", "Creado"},
				                {"updated", "Actualizado"},
				                {"resolutiondate", "Fecha_Resolucion"}
				            }
				        ),
				
				    ColumnasFinales =
				        Table.SelectColumns(
				            Renombrado,
				            {
				                "Ticket",
				                "Nombre del Ticket",
				                "Estado",
				                "Asignado",
				                "Grupo_Resolutor",
				                "Aplicacion",
				                "Prioridad",
				                "Tipo",
				                "Planta",
				                "Creado",
				                "Fecha_Resolucion",
				                "Actualizado",
				                "Atencion_Horas",
				                "Atencion_SLA_Vencido",
				                "Resolucion_Horas",
				                "Resolucion_SLA_Vencido",
				                "Dias_Totales_Cierre",
				                "Informante",
				                "Componente",
				                "Area_Requirente",
				                "Horas_Trabajadas"
				            }
				        ),
				    #"Tipo cambiado" = Table.TransformColumnTypes(ColumnasFinales,{{"Atencion_SLA_Vencido", type logical}, {"Atencion_Horas", type number}}),
				    #"Personalizada agregada" = Table.AddColumn(#"Tipo cambiado", "OrdenPrioridad", each if [Prioridad] = "Bloqueante" then 1
				else if [Prioridad] = "Alta" then 2
				else if [Prioridad] = "Media" then 3
				else if [Prioridad] = "Baja" then 4
				else 99)
				in
				    #"Personalizada agregada"

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

