	column 'Estado Operativo' =
			
			SWITCH(
			    TRUE(),
			    Jira[Estado] = "Cancelado", "Cerrado",
			    Jira[Estado] = "Cerrada", "Cerrado",
			    Jira[Estado] = "Completado", "Cerrado",
			    Jira[Estado] = "Resuelta", "Cerrado",
			
			    Jira[Estado] = "En Curso", "En Trabajo",
			    Jira[Estado] = "En curso", "En Trabajo",
			    Jira[Estado] = "En Implementación", "En Trabajo",
			
			    "Pendiente"
			)
		lineageTag: df5d017c-f023-4f82-9838-437191ce64ba
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Año = YEAR(Jira[Creado])
