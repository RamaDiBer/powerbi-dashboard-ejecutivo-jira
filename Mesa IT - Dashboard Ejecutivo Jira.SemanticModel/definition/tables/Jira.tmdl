table Jira
	lineageTag: 5c20ece5-8fdd-48a5-8973-fd46d4098eb9

	measure 'Total Tickets' =
			
			COUNTROWS('Jira')
		formatString: 0
		lineageTag: ce69ce28-e789-4786-a0ea-1c65d0cec8dc

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Tickets Alta' =
			
			CALCULATE(
			    COUNTROWS(Jira),
			    Jira[Prioridad] = "Alta"
			)
		formatString: 0
		lineageTag: 7560f5b0-1d34-40a1-b34a-7cfca24aff8c

	measure 'Tickets Bloqueantes' = ```
			
			CALCULATE( 
			    COUNTROWS(Jira),
			    Jira[Prioridad] = "Bloqueante"
			)
			```
		formatString: 0
		lineageTag: 8926aa9c-0b44-45b6-988d-22e32210c5e5

	measure 'Tickets Abiertos' =
			
			CALCULATE(
			    COUNTROWS(Jira),
			    NOT Jira[Estado] IN {
			        "Cancelado",
			        "Cerrada",
			        "Completado",
			        "Resuelta",
			        "Resuelto Automation"
			    }
			)
		formatString: 0
		lineageTag: 7b8ca72e-9a9d-4ed3-8b05-68cfa3c0a724

	measure 'Tickets Cerrados' =
			
			CALCULATE(
			    COUNTROWS(Jira),
			    Jira[Estado] IN {
			        "Cancelado",
			        "Cerrada",
			        "Completado",
			        "Resuelta",
			        "Resuelto Automation"
			    }
			)
		formatString: 0
		lineageTag: 70aac4e3-8ac0-4f27-99bd-526aebf44fbb

	measure '% Tickets Abiertos' =
			
			DIVIDE(
			    [Tickets Abiertos],
			    [Total Tickets],
			    0
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 276c2888-fe26-4306-93f8-e5b7b0f23abf

	measure 'Promedio Resolución' =
			
			AVERAGEX(
			    FILTER(Jira, NOT ISBLANK(Jira[Horas Resolución]) && Jira[Horas Resolución] <> ""),
			    VALUE(Jira[Horas Resolución])
			)
		formatString: 0.0
		lineageTag: 15adf12a-3d39-464c-b42f-12207a18ca64

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Promedio Atención' =
			
			AVERAGE(Jira[Atencion_Horas])
		lineageTag: b38da639-a397-42d8-b26d-928e40a7ac1f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Mediana Atención' =
			
			MEDIAN(Jira[Atencion_Horas])
		lineageTag: ba3f1df2-581e-4fac-883a-8c2a3b64094f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Mediana Resolución' =
			
			MEDIAN(Jira[Dias_Totales_Cierre])
		lineageTag: b10a9f5b-155b-4a58-b61a-843f48df5250

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'SLA Vencidos' = ```
			
			CALCULATE(
			    COUNTROWS(Jira),
			    Jira[Atencion_SLA_Vencido] = TRUE()
			)
			
			```
		formatString: 0
		lineageTag: fddf3a97-0f30-46f4-8961-0e8d9dca9b8a

	measure 'SLA Cumplidos' =
			
			CALCULATE(
			    COUNTROWS(Jira),
			    Jira[Atencion_SLA_Vencido]=FALSE()
			)
		formatString: 0
		lineageTag: 71c1ca1e-96a7-4434-a29f-e988d500d874

	measure '% SLA Cumplido' =
			
			DIVIDE(
			    [SLA Cumplidos],
			    [SLA Cumplidos] + [SLA Vencidos]
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 63c64ce8-e0f7-40a2-9643-d503030bd9e3

	measure 'Total Tickets Evolucion' =
			
			CALCULATE(
			    COUNTROWS(Jira),
			    REMOVEFILTERS(Jira[AñoTxt]),
			    REMOVEFILTERS(Jira[MesTxt]),
			    REMOVEFILTERS(Jira[Estado Operativo])
			)
		formatString: 0
		lineageTag: 75d64cea-e763-490e-a270-7e584406156b

	measure 'Cantidad de tickets' =
			
			FORMAT(
			    COUNTROWS(Jira),
			    "#,##0"
			)
		lineageTag: c690c056-70ec-47f1-9d47-dafa2b59d347

	measure 'Tickets Bloqueantes Cerrados' =
			
			CALCULATE(
			    COUNTROWS(Jira),
			    Jira[Prioridad] = "Bloqueante",
			    Jira[Estado Operativo] = "Cerrado"
			)
		formatString: 0
		lineageTag: d92ff7ed-0323-4c10-8fb0-9d1d82eebf52

	measure '% Bloqueantes Cerrados' =
			
			DIVIDE(
			    [Tickets Bloqueantes Cerrados],
			    [Tickets Bloqueantes]
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 0e891323-6865-4c3e-b1e0-7b11a13878c1

	measure 'Tickets Alta Cerrados' =
			
			CALCULATE(
			    COUNTROWS(jira),
			    Jira[Prioridad] = "Alta",
			    Jira[Estado Operativo] = "Cerrado"
			)
		formatString: 0
		lineageTag: 1d21b50c-567b-4f6c-abd9-242efbbdaca6

	measure '% Alta Cerrado' =
			
			DIVIDE(
			    [Tickets Alta Cerrados],
			    [Tickets Alta]
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: c42ca600-cded-40bb-a3a1-deb71ded2cec

	measure '% Tickets Cerrados' = DIVIDE([Tickets Cerrados], [Total Tickets])
		formatString: 0.0 %;-0.0 %;0.0 %
		displayFolder: Resumen Operativo
		lineageTag: c582afd0-4318-4cdb-b18f-fb0bfc192fe0

	measure 'Antigüedad Abiertos (días)' =
			
			AVERAGEX(
			    FILTER(
			        Jira,
			        NOT Jira[Estado] IN { "Cancelado", "Cerrada", "Completado", "Resuelta", "Resuelto Automation" }
			    ),
			    DATEDIFF(Jira[Creado], TODAY(), DAY)
			)
		formatString: 0
		displayFolder: Resumen Operativo
		lineageTag: 2a235cdc-6811-4bb4-b921-53cebb8d7ba4

	measure 'Abiertos +30 días' =
			
			COUNTROWS(
			    FILTER(
			        Jira,
			        NOT Jira[Estado] IN { "Cancelado", "Cerrada", "Completado", "Resuelta", "Resuelto Automation" }
			            && DATEDIFF(Jira[Creado], TODAY(), DAY) > 30
			    )
			) + 0
		formatString: 0
		displayFolder: Resumen Operativo
		lineageTag: 5ff7f315-1153-4234-9fd7-36c39f74bce1

	measure 'Promedio Mensual Tickets' = AVERAGEX(VALUES(Jira[MesAño]), [Total Tickets])
		formatString: 0
		displayFolder: Resumen Operativo
		lineageTag: d7c96845-38b6-4daf-a79b-c1425dd286df

	/// Tickets creados en el mes de la tabla Meses. Ignora los filtros de año/mes de Jira para poder compararse con resueltos.
	measure 'Tickets Creados (mes)' =
			
			CALCULATE(
			    COUNTROWS(Jira),
			    REMOVEFILTERS(Jira[Año], Jira[AñoTxt], Jira[MesNro], Jira[MesTxt], Jira[MesAño], Jira[MesAñoOrdne]),
			    TREATAS(VALUES(Meses[MesOrden]), Jira[MesAñoOrdne])
			)
		formatString: 0
		displayFolder: Análisis Operativo
		lineageTag: ffba0245-eeea-4f90-a269-936f51179f58

	/// Tickets con fecha de resolución en el mes de la tabla Meses.
	measure 'Tickets Resueltos (mes)' =
			
			CALCULATE(
			    COUNTROWS(Jira),
			    REMOVEFILTERS(Jira[Año], Jira[AñoTxt], Jira[MesNro], Jira[MesTxt], Jira[MesAño], Jira[MesAñoOrdne]),
			    TREATAS(VALUES(Meses[MesOrden]), Jira[MesResolucionOrden])
			)
		formatString: 0
		displayFolder: Análisis Operativo
		lineageTag: 7e2c58c5-e97d-49d5-b7b8-7062636d3755

	/// Creados menos resueltos: positivo = se acumulan tickets
	measure 'Saldo del mes' = [Tickets Creados (mes)] - [Tickets Resueltos (mes)]
		formatString: +0;-0;0
		displayFolder: Análisis Operativo
		lineageTag: a42947ed-fb1a-44c8-86e8-18f7cc0c1ff5

	measure Fallas = CALCULATE([Total Tickets], Jira[Categoría] = "Falla")
		formatString: 0
		displayFolder: Análisis Operativo
		lineageTag: 57bada05-cd51-4cd2-a2d2-bc1ffbb43143

	measure Pedidos = CALCULATE([Total Tickets], Jira[Categoría] = "Pedido / Servicio")
		formatString: 0
		displayFolder: Análisis Operativo
		lineageTag: 1cac1ea7-9266-4170-a6f2-7e308a87c97f

	measure '% Fallas' = DIVIDE([Fallas], [Total Tickets])
		formatString: 0.0 %;-0.0 %;0.0 %
		displayFolder: Análisis Operativo
		lineageTag: eb7fc350-e699-42bf-a568-c8b0e247ddd2

	/// Horas registradas en el worklog de Jira
	measure 'Horas Trabajadas' = SUM(Jira[Horas_Trabajadas])
		formatString: #,0
		displayFolder: Análisis Operativo
		lineageTag: ad350a5e-99f0-4996-804a-8ebb1131f887

	/// Promedio de horas registradas, solo tickets con horas cargadas
	measure 'Horas por Ticket' = DIVIDE([Horas Trabajadas], CALCULATE([Total Tickets], Jira[Horas_Trabajadas] > 0))
		formatString: 0.0
		displayFolder: Análisis Operativo
		lineageTag: 4ce13afe-9479-45c3-9736-6c6652856e6d

	/// Cantidad de fallas con el mismo título, solo si se repite 3 o más veces
	measure 'Veces Repetida' =
			
			VAR n = [Fallas]
			RETURN IF(n >= 3, n)
		formatString: 0
		displayFolder: Análisis Operativo
		lineageTag: 1e3f521c-ef1c-4445-b290-72f56de0cb93

	/// Cantidad de títulos de falla distintos que se repiten 3 o más veces
	measure 'Fallas Recurrentes' = COUNTROWS(FILTER(VALUES(Jira[Resumen Normalizado]), [Fallas] >= 3)) + 0
		formatString: 0
		displayFolder: Análisis Operativo
		lineageTag: 6268dd3f-5513-402c-b2cd-29ee872c418a

